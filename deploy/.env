# podman-compose names its pod/network after the current directory's
# basename unless told otherwise. This directory is named "deploy", exactly
# like inkwell's and compliance-lms's deploy directories, so without this
# override podman-compose collides with whichever of those projects' stacks
# is already running (confirmed: it tried to tear down inkwell's live pod
# the first time this was run). COMPOSE_PROJECT_NAME pins this project's
# pod/network/volume names to "ssh-chat" regardless of directory name.
COMPOSE_PROJECT_NAME=ssh-chat

# The status bar's clock renders the container's local time, which without
# this is UTC (the compose.yaml default) regardless of where the host
# actually is. Set to this host's real zone so the clock matches a user
# actually looking at it.
TZ=Australia/Brisbane

# ssh-chat's own settings go here too (compose passes this whole file to the
# container via env_file). Every option, with its default, is documented in
# ../.env.example; uncomment/copy what you want to change, for example:
#SSHCHAT_MAX_CONNS_PER_IP=20
#SSHCHAT_ADMIN_FPS=SHA256:xxxxxxxx
