# ssh-chat settings. Copy to `.env` (compose: deploy/.env) or any file you point
# `env_file:` (compose) / `EnvironmentFile=` (quadlet) / `--env-file` (podman,
# docker run) at. Every line is optional; the value shown is the default.
# Precedence: command-line flag > this environment > built-in default.
# Variable name = SSHCHAT_ + flag name in capitals with "-" as "_".
# Durations: 30s, 5m, 24h, 720h. Booleans: true/false. Empty = default.

# --- Server ---------------------------------------------------------------
# Listen address inside the container (publish the port with -p / ports:).
#SSHCHAT_ADDR=:2222
# SQLite database, SSH host key and admin list. In the image these live in the
# /data volume: keep that volume, losing the host key breaks every client.
#SSHCHAT_DB=/data/chat.db
#SSHCHAT_HOSTKEY=/data/hostkey
#SSHCHAT_ADMINS=/data/admins.txt
# Admin SSH key fingerprints, comma separated, in addition to the admins file.
# (`ssh-keygen -lf ~/.ssh/id_ed25519.pub` prints one.)
#SSHCHAT_ADMIN_FPS=

# --- Limits -----------------------------------------------------------------
# Concurrent connections, and new connections per minute, from one IP address.
#SSHCHAT_MAX_CONNS_PER_IP=10
#SSHCHAT_MAX_CONNS_PER_MIN=30
# Idle time before a user is marked away.
#SSHCHAT_AFK_AFTER=5m

# --- Content ------------------------------------------------------------------
# Mask a built-in list of profanity in chat; optional extra words (one per line).
#SSHCHAT_PROFANITY_FILTER=true
#SSHCHAT_FILTER_WORDS=

# --- Housekeeping ---------------------------------------------------------------
# Chat history older than this is deleted (0 keeps everything).
#SSHCHAT_RETENTION=2160h
# Empty channels with no messages for this long are deleted (0 disables).
#SSHCHAT_ROOM_EXPIRY=720h
# Database backups: directory (default <db dir>/backups, "off" disables), how
# often, and how many to keep. The SSH host key is copied alongside.
#SSHCHAT_BACKUP_DIR=
#SSHCHAT_BACKUP_EVERY=24h
#SSHCHAT_BACKUP_KEEP=7

# --- Bot (SysOp-Gus) -------------------------------------------------------------
#SSHCHAT_BOT=true
# Directory of data files overriding the built-in persona/content, and the
# bot's own database (default <db dir>/bot.db).
#SSHCHAT_BOT_DATA=
#SSHCHAT_BOT_DB=

# --- Debug ----------------------------------------------------------------------
# Serve runtime profiling on this address, e.g. 127.0.0.1:6060 (off by default).
#SSHCHAT_PPROF=

# --- Container (not read by ssh-chat itself) ---------------------------------------
# Time zone for the status-bar clock and the bot's daily schedule.
#TZ=Australia/Brisbane
